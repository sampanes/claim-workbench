{
  "name": "claim-workbench",
  "version": "0.0.0",
  "private": true,
  "description": "Local-first claim workflow workbench prototype.",
  "packageManager": "pnpm@10.28.1",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "bootstrap": "pnpm install --frozen-lockfile",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r test:coverage",
    "stdio:transcript": "node scripts/generate-stdio-transcript.mjs",
    "hooks:install": "node scripts/isolation/install.mjs",
    "verify:clean": "node scripts/isolation/verify-clean.mjs",
    "verify": "pnpm test && pnpm build"
  }
}
