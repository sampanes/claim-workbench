{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://claim-workbench.dev/schemas/artifact-manifest.schema.json",
  "title": "ArtifactManifest",
  "description": "Hashes and provenance for every artifact generated from a packet. The packet fingerprint anchors freshness: changed facts invalidate all entries.",
  "type": "object",
  "required": ["manifestVersion", "packetId", "packetFingerprint", "generatedAt", "entries"],
  "properties": {
    "manifestVersion": { "const": "1" },
    "packetId": { "type": "string", "pattern": "^packet_" },
    "packetFingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "generatedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifactId", "kind", "filename", "mediaType", "bytes", "sha256", "generatedAt"],
        "properties": {
          "artifactId": { "type": "string", "pattern": "^artifact_" },
          "kind": { "type": "string", "minLength": 1 },
          "filename": { "type": "string", "minLength": 1 },
          "mediaType": { "type": "string", "minLength": 1 },
          "bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "generatedAt": { "type": "string" }
        }
      }
    }
  }
}
