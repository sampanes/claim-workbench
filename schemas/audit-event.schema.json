{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://claim-workbench.dev/schemas/audit-event.schema.json",
  "title": "AuditEvent",
  "description": "One auditable workflow event: a human-readable summary plus technical details under the same identifiers.",
  "type": "object",
  "required": ["eventVersion", "id", "runId", "action", "actor", "at", "summary"],
  "properties": {
    "eventVersion": { "const": "1" },
    "id": { "type": "string", "pattern": "^event_" },
    "runId": { "type": "string", "pattern": "^run_" },
    "packetId": { "type": ["string", "null"] },
    "action": { "type": "string", "minLength": 1 },
    "actor": { "type": "string", "minLength": 1 },
    "at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$" },
    "summary": { "type": "string", "minLength": 1 },
    "details": { "type": "object" }
  }
}
