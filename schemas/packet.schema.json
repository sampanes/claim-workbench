{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://claim-workbench.dev/schemas/packet.schema.json",
  "title": "BillingPacket",
  "description": "Normalized billing packet, schema version 1. Money is a decimal string plus an ISO 4217 currency code; service dates are ISO 8601 date-only strings (ADR-0003).",
  "type": "object",
  "required": ["schemaVersion", "id", "client", "destination", "recipeId", "serviceLines", "total"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "id": { "type": "string", "pattern": "^packet_" },
    "createdAt": { "$ref": "#/$defs/utcTimestamp" },
    "client": {
      "type": "object",
      "required": ["id", "displayName"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "displayName": { "type": "string", "minLength": 1 },
        "externalIds": {
          "type": "object",
          "additionalProperties": { "type": ["string", "null"] }
        }
      }
    },
    "destination": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string" }
      }
    },
    "recipeId": { "type": "string", "minLength": 1 },
    "period": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": { "$ref": "#/$defs/isoDate" },
        "end": { "$ref": "#/$defs/isoDate" }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["importBatchId", "sourceName"],
      "properties": {
        "importBatchId": { "type": "string", "minLength": 1 },
        "sourceName": { "type": "string", "minLength": 1 },
        "sourceSha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "adapterId": { "type": "string" },
        "adapterVersion": { "type": "string" },
        "importedAt": { "$ref": "#/$defs/utcTimestamp" }
      }
    },
    "serviceLines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "serviceDate", "code", "amount"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "sourceId": { "type": ["string", "null"] },
          "sourceRow": { "type": "integer", "minimum": 1 },
          "serviceDate": { "$ref": "#/$defs/isoDate" },
          "code": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "units": { "type": "integer", "minimum": 1 },
          "amount": { "$ref": "#/$defs/money" },
          "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "total": { "$ref": "#/$defs/money" },
    "workflowState": {
      "enum": [
        "Imported", "PacketValidated", "ArtifactsGenerated", "DestinationOpened",
        "RecordMatched", "FieldsFilled", "UserReviewed", "Submitted",
        "ReceiptCaptured", "Complete", "ManualHandlingRequired", "HardStopped"
      ]
    },
    "findings": { "type": "array", "items": { "$ref": "finding.schema.json" } },
    "artifacts": { "type": "array" },
    "receipts": { "type": "array" }
  },
  "$defs": {
    "money": {
      "type": "object",
      "required": ["amount", "currency"],
      "properties": {
        "amount": { "type": "string", "pattern": "^(?:0|[1-9][0-9]*)\\.[0-9]{2}$" },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
      }
    },
    "isoDate": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "utcTimestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$" }
  }
}
